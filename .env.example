# ---------------------------------------------------------------------------
# El Arco Laboratorios - variables de entorno
# Copiar este archivo a .env y ajustar los valores antes de levantar Docker.
# El archivo .env NUNCA debe subirse al repositorio.
# ---------------------------------------------------------------------------

NODE_ENV=development
TZ=America/Guatemala

# --- Base de datos ---------------------------------------------------------
DB_NAME=el_arco
DB_USER=arco_app
DB_PASSWORD=cambiar_esta_clave
DB_ROOT_PASSWORD=cambiar_esta_clave_root
DB_PORT=3306

# --- Puertos expuestos en el host -----------------------------------------
BACKEND_PORT=3000
WHATSAPP_PORT=3001
FRONTEND_PORT=5173

# --- Seguridad -------------------------------------------------------------
# JWT_SECRET debe ser una cadena larga y aleatoria. Generar con:
#   openssl rand -base64 48
JWT_SECRET=cambiar_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# Clave compartida entre backend y whatsapp-service (comunicación interna).
INTERNAL_API_KEY=cambiar_esta_clave_interna

# --- CORS ------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# Número de proxies de confianza delante del backend (0 = ninguno).
# Solo debe activarse si hay un nginx/Caddy real delante: confiar en
# X-Forwarded-For sin proxy permitiría falsear la IP y saltarse el límite
# de intentos de inicio de sesión.
TRUST_PROXY=0

# La hora del envío diario de recordatorios ya no se configura aquí: la ajusta
# el administrador desde Configuración y se guarda en la base de datos.

# --- Frontend --------------------------------------------------------------
# La consume el navegador, por eso apunta a localhost y no al nombre del servicio.
VITE_API_URL=http://localhost:3000/api
